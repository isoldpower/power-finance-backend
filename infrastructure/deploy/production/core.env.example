# Core VM .env — copy to .env at the repo root on the core VM, never commit the copy.
# See infrastructure/deploy/production/README.md.
#
# Database and ImmuDB credentials are baked into their volumes on first start.
# Set every password BEFORE the first `make prod-up`.
#
# Generate each secret with:  openssl rand -hex 32

PRODUCTION_ROLE=core

# ── Private network ─────────────────────────────────────────────────────────────
# `hostname -I` on each VM; FQDNs are <hostname>.<subnet-label>.<vcn-label>.oraclevcn.com
CORE_PRIVATE_ADDRESS=
KAFKA_EXTERNAL_HOST=
SEARCH_PRIVATE_HOSTNAME=

# ── Edge ────────────────────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Gateway ─────────────────────────────────────────────────────────────────────
CLERK_ISSUER_URL=
READ_AT_LEAST_HMAC_SECRET=

# ── Django ──────────────────────────────────────────────────────────────────────
WRITE_SERVICE_SECRET_KEY=
DEMO_TOKEN_SECRET=
READ_SERVICE_SECRET_KEY=

# ── Datastores ──────────────────────────────────────────────────────────────────
WRITE_DATABASE_USER=postgres
WRITE_DATABASE_PASSWORD=
READ_DATABASE_USER=postgres
READ_DATABASE_PASSWORD=
AI_DATABASE_USER=postgres
AI_DATABASE_PASSWORD=
WEBHOOK_DATABASE_USER=postgres
WEBHOOK_DATABASE_PASSWORD=

IMMUDB_USER=immudb
IMMUDB_PASSWORD=

# Must equal ELASTIC_PASSWORD on the search VM.
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=

# ── Observability ───────────────────────────────────────────────────────────────
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_TRACES_SAMPLER_ARG=0.1
KONG_TRACING_SAMPLING_RATE=0.1
JAEGER_SPAN_TTL=72h

# ── Backups ─────────────────────────────────────────────────────────────────────
# rclone remote + bucket path, e.g. oci:power-finance-backups. Empty = VM only.
BACKUP_RCLONE_DESTINATION=
BACKUP_RETENTION_DAYS=14
