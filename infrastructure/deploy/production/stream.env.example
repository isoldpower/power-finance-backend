# Stream VM .env — copy to .env at the repo root on the stream VM, never commit the copy.
# See infrastructure/deploy/production/README.md.

PRODUCTION_ROLE=stream

# The core VM's private FQDN: Kafka on :19092, Jaeger OTLP on :4317.
CORE_PRIVATE_HOSTNAME=

OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_TRACES_SAMPLER_ARG=0.1
