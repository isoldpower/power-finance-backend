# Search VM .env — copy to .env at the repo root on the search VM, never commit the copy.
# See infrastructure/deploy/production/README.md.
#
# ELASTIC_PASSWORD is baked into the data volume on first start, and the TLS
# certificate is issued for ELASTICSEARCH_CERTIFICATE_HOSTNAME on first start.
# Set both BEFORE the first `make prod-up`.

PRODUCTION_ROLE=search

# `hostname -I` and `hostname -f` on this VM.
SEARCH_PRIVATE_ADDRESS=
ELASTICSEARCH_CERTIFICATE_HOSTNAME=

ELASTIC_PASSWORD=
KIBANA_PASSWORD=
