# See README.md → "Environment"

# REQUIRED. The gateway fetches {CLERK_ISSUER_URL}/.well-known/jwks.json to verify
# every token; empty or wrong means every request 401s with "identity provider is
# unreachable". Take it from the Clerk dashboard (Frontend API / issuer), e.g.
# https://your-app-123.clerk.accounts.dev — no trailing slash needed.
# Kong resolves it at config load, so recreate api-gateway after changing it, and
# clear any cached JWKS: redis-cli --scan --pattern 'clerk:jwks:*' | xargs redis-cli DEL
CLERK_ISSUER_URL=
READ_AT_LEAST_HMAC_SECRET=

WRITE_SERVICE_SECRET_KEY=dev-only-secret-key-change-me
READ_SERVICE_SECRET_KEY=dev-only-secret-key-change-me

WRITE_DATABASE_NAME=power_finance_write
WRITE_DATABASE_USER=postgres
WRITE_DATABASE_PASSWORD=postgres
WRITE_DATABASE_PORT=5433

READ_DATABASE_NAME=power_finance_read
READ_DATABASE_USER=postgres
READ_DATABASE_PASSWORD=postgres
READ_DATABASE_PORT=5434

AI_DATABASE_NAME=power_finance_ai
AI_DATABASE_USER=postgres
AI_DATABASE_PASSWORD=postgres
AI_DATABASE_PORT=5436

WEBHOOK_DATABASE_NAME=power_finance_webhooks
WEBHOOK_DATABASE_USER=postgres
WEBHOOK_DATABASE_PASSWORD=postgres
WEBHOOK_DATABASE_PORT=5435

IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb

STACK_VERSION=9.4.2
CLUSTER_NAME=docker-cluster
LICENSE=basic
MEM_LIMIT=3221225472
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme
ES_PORT=127.0.0.1:9200
KIBANA_PORT=127.0.0.1:5601

GATEWAY_PROXY_PORT=8080
GATEWAY_ADMIN_PORT=8001
CLOUDFLARE_TUNNEL_TOKEN=

LOG_LEVEL=INFO
AUTOMATION_SCHEDULE_INTERVAL_SECONDS=300
PUSH_SERVICE_HEARTBEAT_INTERVAL_SECONDS=15
FRAUD_SCORE_THRESHOLD=4.0
WEBHOOK_DELIVERY_MAX_ATTEMPTS=5
WEBHOOK_DELIVERY_RETRY_BACKOFF_SECONDS=30
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_DELIVERY_SCHEDULER_INTERVAL_SECONDS=15

# Tracing (observability-py + the Kong opentelemetry plugin). Tracing stays off
# until OTEL_EXPORTER_OTLP_ENDPOINT is set, so a plain local run stays silent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_SDK_DISABLED=false
KONG_TRACING_INSTRUMENTATIONS=all
KONG_TRACING_SAMPLING_RATE=1.0
JAEGER_UI_PORT=16686
JAEGER_SPAN_TTL=72h
JAEGER_MAX_TRACES=20000

# Shared dev environment. Leave SANDBOX_ID empty everywhere except inside a
# sandbox: an empty value means "baseline", which owns all untagged traffic.
SANDBOX_ID=
BASELINE_NETWORK_NAME=pf-baseline_default

# Dev-host bindings, split by how much exposure each deserves. Under colima use
# 0.0.0.0, never a Tailscale IP — see infrastructure/dev-host/README.md.
#
#   PROXY_BIND_ADDRESS  the API gateway. The only port developers need, because
#                       sandboxes run on the host. 0.0.0.0 on a shared host.
#   BIND_ADDRESS        Postgres, Redis, ImmuDB, Kafka's external listener and
#                       OTLP ingest. Loopback unless you want psql from a laptop
#                       or use the off-host escape hatch.
#   ADMIN_BIND_ADDRESS  Kong's admin API (unauthenticated — full gateway config),
#                       the Jaeger UI and the Flink UI. Keep loopback and tunnel.
PROXY_BIND_ADDRESS=127.0.0.1
BIND_ADDRESS=127.0.0.1
ADMIN_BIND_ADDRESS=127.0.0.1

# Kafka's external listener. KAFKA_EXTERNAL_HOST must be the name a laptop uses,
# because a client reconnects to whatever the broker advertises.
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=19092

WRITE_DATABASE_EXTERNAL_PORT=5433
READ_DATABASE_EXTERNAL_PORT=5434
AI_DATABASE_EXTERNAL_PORT=5436
WEBHOOK_DATABASE_EXTERNAL_PORT=5437
WRITE_REDIS_EXTERNAL_PORT=6383
READ_REDIS_EXTERNAL_PORT=6384
IMMUDB_EXTERNAL_PORT=3322
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Set only inside a sandbox that must not write into the baseline's read model;
# `make sandbox-up ISOLATED=1` sets it to sbx_<sandbox>_ automatically.
ELASTICSEARCH_INDEX_PREFIX=
