# Django
# =============================================================================
*.log
*.pot
*.mo
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
local_settings.py

# =============================================================================
# Environment files (secrets — never commit)
# =============================================================================
.env
.env.*
!.env.example
!.env.*.example

# =============================================================================
# Go (services/push_service)
# =============================================================================
# Compiled binaries
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out

# Build artifacts
services/push-service/bin/
services/push-service/dist/

# Go workspace files (we use go.mod per-service; no go.work yet)
go.work
go.work.sum

# Vendored deps (we don't vendor by default)
vendor/

# =============================================================================
# IDEs
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~

