# Write Service — environment template.
# Copy to `.env` and fill in real values for local development.
# `.env` is gitignored; `.env.example` is committed.

# --- Django core ---
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=*
APP_NAME=write_service
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Write Postgres) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=power_finance_write

# --- Redis (fraud fast-path) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- ImmuDB (audit log) ---
IMMUDB_HOST=localhost
IMMUDB_PORT=3322
IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb

# --- Kafka (consumer for fraud signals; outbox is published by Debezium) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_OUTBOX_TOPIC=events.async
KAFKA_FRAUD_SIGNALS_TOPIC=fraud.signals

# --- Correlation ID ---
# Header name expected on inbound requests (set by the API Gateway). Must
# match what Kong is configured to propagate.
CORRELATION_ID_HEADER=X-Correlation-ID
