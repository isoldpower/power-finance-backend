# See ../../README.md → "Environment"
# Overrides .env for write-service; a shell variable overrides this.
# Uncomment only what you are changing.

# WRITE_DATABASE_NAME=power_finance_write
# WRITE_DATABASE_USER=postgres
# WRITE_DATABASE_PASSWORD=
# WRITE_DATABASE_PORT=5433
# WRITE_SERVICE_SECRET_KEY=
# IMMUDB_USER=immudb
# IMMUDB_PASSWORD=
# KAFKA_OUTBOX_TOPIC=events.async
# KAFKA_AUTOMATION_ENGINE_GROUP_ID=write-service.automation-engine
# KAFKA_FRAUD_ALERTS_TOPIC=fraud.alerts
# KAFKA_FRAUD_ALERTS_GROUP_ID=write-service.fraud-alerts
# KAFKA_NOTIFICATIONS_INBOUND_TOPIC=notifications.inbound
# KAFKA_NOTIFICATIONS_INBOUND_GROUP_ID=write-service.notifications-inbound
# AUTOMATION_SCHEDULE_INTERVAL_SECONDS=300
