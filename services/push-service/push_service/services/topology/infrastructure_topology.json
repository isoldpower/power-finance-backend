  "connections": [
    {
      "from": "browser",
      "to": "api-gateway",
      "kind": "request",
      "protocol": "https",
      "description": "Every API call, including the SSE and WebSocket streams."
    },
    {
      "from": "api-gateway",
      "to": "clerk",
      "kind": "request",
      "protocol": "https",
      "description": "Fetches the JWKS used to verify session tokens."
    },
    {
      "from": "api-gateway",
      "to": "gateway-redis",
      "kind": "query",
      "protocol": "resp",
      "description": "JWKS cache, rate limits, read-your-writes versions, sandbox routes."
    },
    {
      "from": "api-gateway",
      "to": "write-service",
      "kind": "request",
      "protocol": "http",
      "description": "POST, PUT, PATCH and DELETE under /api/v1, plus read fallbacks."
    },
    {
      "from": "api-gateway",
      "to": "read-service",
      "kind": "request",
      "protocol": "http",
      "description": "GET under /api/v1 and search queries."
    },
    {
      "from": "api-gateway",
      "to": "ai-service",
      "kind": "request",
      "protocol": "http",
      "description": "Assistant chat (WebSocket) and assistant endpoints."
    },
    {
      "from": "api-gateway",
      "to": "push-service",
      "kind": "request",
      "protocol": "http",
      "description": "Notification SSE stream and this demo's span stream."
    },
    {
      "from": "api-gateway",
      "to": "webhook-service",
      "kind": "request",
      "protocol": "http",
      "description": "Webhook delivery history."
    },
    {
      "from": "write-service",
      "to": "postgres-write",
      "kind": "query",
      "protocol": "sql",
      "description": "Write model and outbox rows in one transaction."
    },
    {
      "from": "write-service",
      "to": "write-redis",
      "kind": "query",
      "protocol": "resp",
      "description": "Idempotency keys."
    },
    {
      "from": "write-service",
      "to": "immudb",
      "kind": "query",
      "protocol": "grpc",
      "description": "Appends the money flows of each transaction."
    },
    {
      "from": "postgres-write",
      "to": "debezium",
      "kind": "cdc",
      "protocol": "postgres-wal",
      "description": "Debezium tails the write outbox through logical replication."
    },
    {
      "from": "postgres-ai",
      "to": "debezium",
      "kind": "cdc",
      "protocol": "postgres-wal",
      "description": "Debezium tails the AI outbox through logical replication."
    },
    {
      "from": "debezium",
      "to": "topic:events.async",
      "kind": "publish",
      "protocol": "kafka",
      "description": "Each outbox row becomes one event, keyed by the user's Clerk id."
    },
    {
      "from": "topic:events.async",
      "to": "read-write-consumer",
      "kind": "consume",
      "protocol": "kafka",
      "description": "Consumer group read-service.write-consumer."
    },
    {
      "from": "topic:events.async",
      "to": "ai-dispatcher",
      "kind": "consume",
      "protocol": "kafka",
      "description": "Consumer group ai-service.dispatcher."
    },
    {
      "from": "topic:events.async",
      "to": "webhook-service",
      "kind": "consume",
      "protocol": "kafka",
      "description": "Consumer group webhook-service.deliveries."
    },
    {
      "from": "topic:events.async",
      "to": "antifraud-service",
      "kind": "consume",
      "protocol": "kafka",
      "description": "Consumer group antifraud-service."
    },
    {
      "from": "topic:events.async",
      "to": "write-automation-engine",
      "kind": "consume",
      "protocol": "kafka",
      "description": "Consumer group write-service.automation-engine."
    },
    {
      "from": "topic:events.async",
      "to": "push-service",
      "kind": "consume",
      "protocol": "kafka",
      "description": "Groupless broadcast; every replica reads every partition."
    },
    {
      "from": "write-automation-engine",
      "to": "postgres-write",
      "kind": "query",
      "protocol": "sql",
      "description": "Loads rules and applies their effects through the outbox."
    },
    {
      "from": "write-automation-engine",
      "to": "immudb",
      "kind": "query",
      "protocol": "grpc",
      "description": "Rules that create transactions append money flows."
    },
    {
      "from": "write-automation-scheduler",
      "to": "postgres-write",
      "kind": "query",
      "protocol": "sql",
      "description": "Loads scheduled rules and applies their effects."
    },
    {
      "from": "write-automation-scheduler",
      "to": "immudb",
      "kind": "query",
      "protocol": "grpc",
      "description": "Rules that create transactions append money flows."
    },
    {
      "from": "write-action-expiry-sweeper",
      "to": "postgres-write",
      "kind": "query",
      "protocol": "sql",
      "description": "Expires pending actions."
    },
    {
      "from": "read-write-consumer",
      "to": "postgres-read",
      "kind": "query",
      "protocol": "sql",
      "description": "Updates read projections."
    },
    {
      "from": "read-write-consumer",
      "to": "elasticsearch",
      "kind": "query",
      "protocol": "https",
      "description": "Updates search documents."
    },
    {
      "from": "read-write-consumer",
      "to": "read-redis",
      "kind": "query",
      "protocol": "resp",
      "description": "Invalidates cached responses."
    },
    {
      "from": "read-write-consumer",
      "to": "topic:read-service.retry",
      "kind": "publish",
      "protocol": "kafka",
      "description": "Schedules a retry for a failed event."
    },
    {
      "from": "topic:read-service.retry",
      "to": "read-write-consumer",
      "kind": "consume",
      "protocol": "kafka",
      "description": "Re-processes delayed events."
    },
    {
      "from": "read-write-consumer",
      "to": "topic:read-service.dlq",
      "kind": "publish",
      "protocol": "kafka",
      "description": "Parks events that exhausted their retries."
    },
    {
      "from": "read-service",
      "to": "postgres-read",
      "kind": "query",
      "protocol": "sql",
      "description": "Serves read models."
    },
    {
      "from": "read-service",
      "to": "read-redis",
      "kind": "query",
      "protocol": "resp",
      "description": "Response cache."
    },
    {
      "from": "read-service",
      "to": "elasticsearch",
      "kind": "query",
      "protocol": "https",
      "description": "Full-text search and analytics."
    },
    {
      "from": "read-service",
      "to": "exchange-rates-api",
      "kind": "request",
      "protocol": "https",
      "description": "Currency conversion for aggregated views."
    },
    {
      "from": "ai-service",
      "to": "postgres-ai",
      "kind": "query",
      "protocol": "sql",
      "description": "Accounts, entries and chat state."
    },
    {
      "from": "ai-dispatcher",
      "to": "postgres-ai",
      "kind": "query",
      "protocol": "sql",
      "description": "Writes postings and AI outbox rows."
    },
    {
      "from": "ai-dispatcher",
      "to": "exchange-rates-api",
