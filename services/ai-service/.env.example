# AI Service — environment template.
# Copy to `.env` and fill in real values for local development.
# `.env` is gitignored; `.env.example` is committed.
# Every variable here is required: ai-service declares no defaults, so a
# missing one fails at startup instead of running against the wrong broker.

# --- Database (AI Postgres) ---
# This service's own database, published on 127.0.0.1:5436 by its compose file.
AI_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5436/power_finance_ai

# --- Kafka (dispatcher consumer; the outbox is published by Debezium) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_OUTBOX_TOPIC=events.async
KAFKA_AI_GROUP_ID=ai-service.dispatcher
# Retry and DLQ are this service's own, not the library defaults: read-service
# handles the same event types, and a shared retry topic would hand it this
# service's failures to reprocess.
KAFKA_RETRY_TOPIC=ai-service.retry
KAFKA_DLQ_TOPIC=ai-service.dlq

# --- Logging ---
LOG_LEVEL=INFO
