# --- Database (Read Postgres) ---
DATABASE_HOST=postgres-read
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=power_finance_read

# --- Elastic Search Server ---
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme
STACK_VERSION=<SPECIFIC.VERSION.NUMBER>
ES_PORT=127.0.0.1:9200
KIBANA_PORT=5601
CLUSTER_NAME=docker-cluster
LICENSE=basic
MEM_LIMIT=1073741824

# --- Elasticsearch Client (read-service consumer + app) ---
# In compose these come from the x-elasticsearch-env anchor (host es01:9200,
# CA-verified). These values target a cluster reached from the host instead;
# self-signed local clusters need VERIFY_CERTS=false unless CA_CERTS is set.
ELASTICSEARCH_HOSTS=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_VERIFY_CERTS=false

# --- Exchange rates (GET /currencies/rates, GET /currencies/convert) ---
# `open-er-api` is the live feed: free, no key, publishes once a day. `static`
# serves fixed placeholder numbers and talks to nothing — for offline work only.
EXCHANGE_RATES_PROVIDER=open-er-api
EXCHANGE_RATES_BASE_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATES_TIMEOUT_SECONDS=5.0
# How often we ASK the feed.
EXCHANGE_RATES_TTL_SECONDS=900
# How old the feed's OWN timestamp may be before a reading is refused with 409
# rate_unavailable. A TTL cannot express this: a stalled feed keeps answering.
EXCHANGE_RATES_MAX_AGE_SECONDS=172800
