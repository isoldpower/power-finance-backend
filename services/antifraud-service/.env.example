# --- Kafka ---
# Host-local runs talk to the broker on localhost; in compose the broker is
# reached at kafka:9092 (set directly in compose.yaml, not from this file).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_OUTBOX_TOPIC=events.async
# Outbound topic the Flink job posts fraud alerts to.
KAFKA_ALERTS_TOPIC=fraud.alerts
# Consumer group; compose reads this as ANTIFRAUD_KAFKA_GROUP_ID for substitution.
ANTIFRAUD_KAFKA_GROUP_ID=antifraud-service

# --- Fraud scoring ---
# Alert when a transaction's summed rule score exceeds this threshold.
FRAUD_SCORE_THRESHOLD=4.0

# --- Logging ---
LOG_LEVEL=info
