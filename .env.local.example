# Laptop .env — for running a service locally against the shared dev host.
#
# Copy to .env in your clone and fill in the passwords your dev host uses. This is
# NOT the host's .env: it deliberately holds no Clerk issuer, no gateway HMAC secret
# and no bind addresses, because a laptop never runs the gateway or the baseline.
#
# Hosts are absent on purpose. `make sandbox-env NAME=… SERVICE=… DEV_HOST=localhost`
# supplies the host for every endpoint, and `localhost` is right because
# `make sandbox-tunnels` puts the dev host's services on your own loopback.

# ── Credentials: must match the dev host exactly ────────────────────────────────
# Wrong values here surface as a 500 from your service, not a connection error.
WRITE_DATABASE_USER=postgres
WRITE_DATABASE_PASSWORD=
READ_DATABASE_USER=postgres
READ_DATABASE_PASSWORD=
AI_DATABASE_USER=postgres
AI_DATABASE_PASSWORD=
WEBHOOK_DATABASE_USER=postgres
WEBHOOK_DATABASE_PASSWORD=

IMMUDB_USER=immudb
# The server runs with --force-admin-password, so this is reapplied on every start
# rather than frozen at first init — but it must still match the host's value.
IMMUDB_PASSWORD=

ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=

# ── Database names: only if the host changed them from these ────────────────────
WRITE_DATABASE_NAME=power_finance_write
READ_DATABASE_NAME=power_finance_read
AI_DATABASE_NAME=power_finance_ai
WEBHOOK_DATABASE_NAME=power_finance_webhooks

# ── Ports: only if the host changed them ────────────────────────────────────────
# A tunnel forwards each port to the same number on the host, so these must agree
# with the host's values. Leaving them out uses the same defaults the host uses.
# WRITE_DATABASE_EXTERNAL_PORT=5433
# READ_DATABASE_EXTERNAL_PORT=5434
# AI_DATABASE_EXTERNAL_PORT=5436
# WEBHOOK_DATABASE_EXTERNAL_PORT=5437
# WRITE_REDIS_EXTERNAL_PORT=6383
# READ_REDIS_EXTERNAL_PORT=6384
# IMMUDB_EXTERNAL_PORT=3322
# ELASTICSEARCH_EXTERNAL_PORT=9200
# KAFKA_EXTERNAL_PORT=19092
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
# JAEGER_UI_PORT=16686

# ── Do NOT set these on a laptop ────────────────────────────────────────────────
# ELASTICSEARCH_HOSTS   the host uses https://es01:9200, a Docker-internal name that
#                       does not resolve here. Leave it unset and the generator uses
#                       https://localhost:9200 — your tunnel. It is the one endpoint
#                       `sandbox-env` will take from your environment rather than
#                       build from DEV_HOST, so setting it sends Elasticsearch — and
#                       only Elasticsearch — around the tunnel, at the dev host's
#                       published port, which BIND_ADDRESS keeps on its loopback.
#                       The generator warns when yours names another host.
# KAFKA_EXTERNAL_HOST   a host-side setting; it controls what the broker advertises.
# BIND_ADDRESS / PROXY_BIND_ADDRESS / ADMIN_BIND_ADDRESS
#                       host-side publishing; nothing here listens.
# CLERK_ISSUER_URL / READ_AT_LEAST_HMAC_SECRET
#                       gateway secrets; the gateway runs on the host, not here.
